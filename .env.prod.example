# Environment for the PUBLIC deploy (compose.prod.yaml). Copy to a file OUTSIDE
# the checkout — /etc/campaign-settings.env is what DEPLOY.md assumes — and
# `chmod 600` it: it holds the database password and the session secret.
#
#   docker compose -f compose.prod.yaml --env-file /etc/campaign-settings.env up -d
#
# It is read by compose at RUN time and is never copied into the image; the
# .dockerignore keeps every .env out of the build context so it cannot be.
#
# Every value below without a default is declared `${VAR:?...}` in
# compose.prod.yaml, so a missing one fails the stack loudly at `up` rather than
# booting something half-configured.

# ── the domain ────────────────────────────────────────────────────────────────
# Apex only. Caddy serves this and redirects www.<SITE_HOST> to it.
SITE_HOST=campaign-settings.com
# Where Let's Encrypt sends expiry warnings. A real mailbox someone reads.
ACME_EMAIL=you@example.com

# ── database ──────────────────────────────────────────────────────────────────
# compose builds DATABASE_URL from these three, so the password lives in exactly
# one place. Do NOT also set DATABASE_URL here.
POSTGRES_USER=campaign
POSTGRES_PASSWORD=          # openssl rand -base64 32
POSTGRES_DB=campaign

# ── app ───────────────────────────────────────────────────────────────────────
# MUST be >= 32 characters. Changing it signs every existing session out.
SESSION_SECRET=             # openssl rand -base64 48

# Optional. Session lifetime in days (default 30).
# SESSION_TTL_DAYS=30

# Reverse-proxy hops in front of the app. compose.prod.yaml already sets this to
# 1 for the Caddy in this stack, so there is nothing to do here — it is listed
# because it is a security property. Without it the app sees Caddy's address as
# every visitor's, and the per-IP rate limits on login/register/reset become one
# bucket shared by the whole internet. Only ever set it to the number of proxies
# that a request MUST pass through to reach the app.
# TRUST_PROXY=1

# ── outbound email ────────────────────────────────────────────────────────────
# Password reset and email verification. WITHOUT THESE the app logs "a reset was
# requested" and sends nothing — safe in dev, silent and useless in production.
#
# All three are required together: the server refuses to boot on half a
# configuration rather than sending links to nowhere. Leave all three unset to
# stay on the logging mailer deliberately.
#
# The key is a secret. It lives here and nowhere else — never the repo, never
# the image (.dockerignore keeps every .env* out of the build context).
#
# See DEPLOY.md §"Outbound email" for the Resend signup and the DNS records.
# RESEND_API_KEY=re_...
# MAIL_FROM=CampaignSettings <no-reply@campaign-settings.com>
# APP_ORIGIN=https://campaign-settings.com

# ── access gates ──────────────────────────────────────────────────────────────
# All SIX are fail-closed: a surface is off unless the value is exactly `true`,
# and a typo leaves it off rather than open. Off is the portfolio posture — the
# blocked surfaces route to the contact modal instead of erroring — so the
# defaults below are a deliberate choice, not an oversight.
#
# Decide these consciously. With LOGIN_ENABLED off, registration still succeeds
# and the very next login returns 403, which reads like a broken deploy rather
# than a closed door.
#
# The private/invited deployment wants login on and demo off:
#   LOGIN_ENABLED=true
#   ACCOUNT_MANAGEMENT_ENABLED=true
#   SUGGESTIONS_ENABLED=true
#   PASSWORD_RESET_ENABLED=true
#
# The public portfolio demo wants the inverse — demo on, real sign-in off:
#   DEMO_MODE=true
#   DEMO_USERNAME=demo
# ACCOUNT_MANAGEMENT_ENABLED is best left off here, but it is no longer a rule
# you have to remember: the demo principal is refused the whole /api/account/*
# family server-side, reads included, so the two flags can both be on safely.
# See DEPLOY.md §"Turning the demo on".

# LOGIN_ENABLED=false
# PUBLIC_SIGNUP_ENABLED=false
# PASSWORD_RESET_ENABLED=false
# SUGGESTIONS_ENABLED=false
# ACCOUNT_MANAGEMENT_ENABLED=false
# DEMO_MODE=false
# DEMO_USERNAME=demo
