# Copy to .env for local dev (.env is gitignored). Matches compose.yaml.
# The test harness derives a maintenance connection (to the `postgres` db) from
# this URL to CREATE/DROP isolated test databases, so a single URL is enough.
DATABASE_URL=postgres://campaign:campaign@localhost:5433/campaign_dev

# Secret for signing session cookies — set to a long random string (>= 32 chars),
# e.g. `openssl rand -base64 48`. Required by the server's auth.
SESSION_SECRET=dev-only-insecure-secret-change-me-0123456789
# Optional: session lifetime in days (default 30).
# SESSION_TTL_DAYS=30

# Optional: public self-serve registration. Fail-closed — signup is CLOSED
# unless this is exactly `true`, so a misconfigured deploy never opens it by
# accident. Invitation holders can still register while it is off.
# PUBLIC_SIGNUP_ENABLED=false

# Optional: resource ceilings (task 3615). These cap how MUCH one actor can
# accumulate; rate limiting caps how FAST. A missing, unparseable, or
# non-positive value falls back to the default rather than removing the limit.
# Defaults suit a portfolio demo; raise them for a real user base.
# MAX_WORLDS_PER_ACCOUNT=5
# MAX_ENTITIES_PER_WORLD=2000
# MAX_MEDIA_BYTES_PER_WORLD=104857600

# Optional: access gates (task 3630). Each surface is independently switchable
# and FAIL-CLOSED — off unless the value is exactly `true`. When off, the SPA
# opens the contact modal and the endpoint refuses server-side, so a script
# cannot reach a gated flow either. The portfolio deployment runs with all of
# these off; flip one on to restore the real flow with no code change.
# LOGIN_ENABLED=false
# PASSWORD_RESET_ENABLED=false
# SUGGESTIONS_ENABLED=false
# ACCOUNT_MANAGEMENT_ENABLED=false

# Optional: demo mode (tasks 3633 / 3631). ON for the public portfolio, OFF for
# the private instance — a runtime switch, not a fork. With it on, POST
# /api/demo-login signs a visitor in as the shared account named below, and that
# account is refused EVERY mutation server-side, and the whole /api/account/*
# family including its reads. The account must already exist; demo mode never
# creates one.
# DEMO_MODE=false
# DEMO_USERNAME=demo
