# Keep the build context small and, more importantly, keep secrets and local
# state out of it entirely — anything listed here cannot end up in a layer even
# by accident.
node_modules
**/node_modules
.git
.gitea

# secrets / local env. The prod env file is read by compose at RUN time and is
# never copied into the image.
.env
.env.*
!.env.example

# build outputs — the image builds its own from source
dist
**/dist
coverage
*.tsbuildinfo

# local media + databases
packages/server/.uploads
*.db
*.db-wal
*.db-shm
/data

# test + tooling artifacts
e2e/test-results
e2e/playwright-report
.cache
*.log
